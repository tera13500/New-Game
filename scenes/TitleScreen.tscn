horizontal_alignment = 1
modulate = Color(0.56, 0.84, 1, 1)
theme_override_font_sizes/font_size = 20

[node name="Intro" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
autowrap_mode = 2
text = "엘리베이터 2대를 운영하며 안전, 점검, 민원, 만족도를 균형 관리하는\n도트 감성 운영 시뮬레이션 게임입니다."
theme_override_font_sizes/font_size = 20

[node name="Role" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
autowrap_mode = 2
text = "당신은 건물의 승강기 운영 책임자입니다. 작은 경고를 먼저 잡아 대형 사고를 막으세요."

[node name="Goal" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
autowrap_mode = 2
text = "핵심 목표: 고장 최소화 · 점검률 유지 · 민원 억제 · 일일 목표 달성"

[node name="LoopPanel" type="PanelContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBox_loop")

[node name="LoopText" type="Label" parent="Center/Panel/VBox/LoopPanel"]
layout_mode = 2
autowrap_mode = 2
text = "플레이 루프: 상태 확인 → 액션 선택 → 이벤트 대응 → Day 리포트 반영"

[node name="HelperLabel" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "처음이라면 튜토리얼 시작을 권장합니다."
modulate = Color(1, 0.9, 0.6, 1)

[node name="Buttons" type="VBoxContainer" parent="Center/Panel/VBox"]
